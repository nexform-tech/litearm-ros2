# Multi-waypoint cartesian path (SDK Arm::move_path).
#
# poses is flat: six values per waypoint, in order. Refused unless allow_motion:=true.

float64[] poses           # 6 values per waypoint
float64 speed
bool wait
---
bool success
string message
bool settled
int32 err
int32 waypoints
uint32 plan_us
float64 settle_err_rad
float64[] q_final

# Write one axis of the joint parameter table's gain part (firmware CMD_SET_JOINT_PARAM).
#
# These are the kp/kd/tau_max the firmware's own position loop uses; the ros2_control
# hardware component sends no gains of its own.

int32 joint            # axis index
float64 kp
float64 kd
float64 tau_max
---
bool success
string message
